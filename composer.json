{
    "name": "refresj/facebook-socialplugins",
    "type": "typo3-cms-extension",
    "version": "14.3.1",
    "description": "Facebook Social Plugins - All Social Plugins from Facebook (https://developers.facebook.com/docs/plugins/)",
    "keywords": [
        "TYPO3",
        "TYPO3 CMS",
        "extension",
        "Facebook",
        "social plugins",
        "share button",
        "page plugin"
    ],
    "homepage": "https://extensions.typo3.org/extension/facebook_socialplugins",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Nitin Parri",
            "role": "Developer",
            "email": "nitin@refresj.nl",
            "homepage": "https://refresj.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/NitinParri/facebook_socialplugins/issues",
        "source": "https://github.com/NitinParri/facebook_socialplugins"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://paypal.me/NitinParri"
        }
    ],
    "require": {
        "php": "^8.5",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-frontend": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "Refresj\\FacebookSocialplugins\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "facebook_socialplugins",
            "version": "14.3.1",
            "Package": {
                "providesPackages": {}
            }
        }
    }
